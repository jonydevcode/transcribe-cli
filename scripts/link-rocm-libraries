#!/usr/bin/env bash
set -euo pipefail

torch_lib="${VIRTUAL_ENV:-$PWD/.venv}/lib/python3.12/site-packages/torch/lib"

if [[ ! -d "$torch_lib" ]]; then
  echo "PyTorch library directory not found: $torch_lib" >&2
  echo "Run 'uv sync --frozen' first." >&2
  exit 1
fi

linked=0
shopt -s nullglob
for library in "$torch_lib"/*.so; do
  soname="$(patchelf --print-soname "$library" 2>/dev/null || true)"
  [[ -n "$soname" ]] || continue

  link="$torch_lib/$soname"
  [[ "$link" != "$library" ]] || continue
  [[ -e "$link" ]] && continue

  ln -s "$(basename "$library")" "$link"
  linked=$((linked + 1))
done

echo "Created $linked missing ROCm library link(s) in $torch_lib"
